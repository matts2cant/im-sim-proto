[gd_scene format=3]

[ext_resource type="Script" path="res://ui/game_menu/settings_menu.gd" id="1_settings"]
[ext_resource type="Theme" path="res://ui/game_menu/game_menu_theme.tres" id="2_theme"]

[sub_resource type="LabelSettings" id="Label_header"]
font_size = 24
font_color = Color(0.55, 0.92, 0.88, 1)

[sub_resource type="LabelSettings" id="Label_hint"]
font_size = 13
font_color = Color(0.5, 0.64, 0.64, 1)

[node name="SettingsMenu" type="PanelContainer"]
