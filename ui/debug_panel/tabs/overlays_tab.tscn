[gd_scene format=3]

[ext_resource type="Script" path="res://ui/debug_panel/tabs/overlays_tab.gd" id="1_tab"]
[ext_resource type="PackedScene" path="res://ui/debug_panel/tabs/awareness_toggles.tscn" id="2_awareness"]

[node name="OverlaysTab" type="VBoxContainer"]
script = ExtResource("1_tab")

[node name="Stimuli" type="CheckBox" parent="."]
layout_mode = 2
tooltip_text = "Draw stimulus radii (wire spheres) and noise paths (lines) for 1.5 s"
text = "Stimuli"

[node name="Heat" type="CheckBox" parent="."]
layout_mode = 2
tooltip_text = "Label flammables and explosives with heat / threshold and fuel left"
text = "Heat"

[node name="AwarenessToggles" parent="." instance=ExtResource("2_awareness")]
layout_mode = 2
