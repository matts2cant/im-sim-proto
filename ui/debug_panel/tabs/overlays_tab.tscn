[gd_scene format=3]

[ext_resource type="Script" path="res://ui/debug_panel/tabs/overlays_tab.gd" id="1_tab"]
[ext_resource type="Script" path="res://ui/debug_panel/tabs/light_level_readout.gd" id="2_light_readout"]
[ext_resource type="PackedScene" path="res://ui/debug_panel/tabs/awareness_toggles.tscn" id="3_awareness"]

[node name="OverlaysTab" type="VBoxContainer"]
script = ExtResource("1_tab")

[node name="Stimuli" type="CheckBox" parent="."]
layout_mode = 2
tooltip_text = "Draw stimulus radii (wire spheres) and noise paths (lines) for 1.5 s"
text = "Stimuli"

[node name="Heat" type="CheckBox" parent="."]
layout_mode = 2
tooltip_text = "Label flammables and explosives with heat / threshold and fuel left"
text = "Heat"

[node name="Network" type="CheckBox" parent="."]
layout_mode = 2
tooltip_text = "Label every network device with its name and status, and draw its cables (green up, red down), through walls"
text = "Network"

[node name="LightLevel" type="Label" parent="."]
layout_mode = 2
tooltip_text = "The player's light level (0 dark .. 1 lit) and the lights that reach it"
mouse_filter = 1
text = "Light: no player"
script = ExtResource("2_light_readout")

[node name="AwarenessToggles" parent="." instance=ExtResource("3_awareness")]
layout_mode = 2
