[gd_resource type="Resource" script_class="MissionData" format=3]

[ext_resource type="Script" path="res://levels/mission/mission_kit/mission_data.gd" id="1_data"]
[ext_resource type="Script" path="res://levels/mission/mission_kit/objectives/mission_objective.gd" id="2_objective"]
[ext_resource type="Script" path="res://levels/mission/mission_kit/objectives/read_entry_objective.gd" id="3_read"]
[ext_resource type="Script" path="res://levels/mission/mission_kit/objectives/pick_up_objective.gd" id="4_pick_up"]
[ext_resource type="Script" path="res://levels/mission/mission_kit/objectives/sabotage_objective.gd" id="5_sabotage"]
[ext_resource type="Script" path="res://items/inventory/starting_item.gd" id="6_starting_item"]
[ext_resource type="Resource" path="res://items/weapons/baton/baton_item.tres" id="7_baton"]
[ext_resource type="Resource" path="res://items/weapons/pistol/pistol_item.tres" id="8_pistol"]
[ext_resource type="Resource" path="res://items/pistol_ammo/pistol_ammo.tres" id="9_ammo"]
[ext_resource type="Resource" path="res://items/medkit/medkit.tres" id="10_medkit"]
[ext_resource type="PackedScene" path="res://actors/guard/guard_pistol.tscn" id="11_guard_pistol"]

[sub_resource type="Resource" id="Objective_manifest"]
script = ExtResource("3_read")
entry_id = &"fixture.manifest"
id = &"manifest"
title = "Read the test manifest"
description = "A datapad on the floor ahead."
extraction_hint = "Read the test manifest first"

[sub_resource type="Resource" id="Objective_keycard"]
script = ExtResource("4_pick_up")
item_id = &"keycard"
id = &"keycard"
title = "Take the keycard"
description = "A keycard on the floor."
optional = true

[sub_resource type="Resource" id="Objective_shipment"]
script = ExtResource("5_sabotage")
tag = &"mission.shipment"
id = &"shipment"
title = "Sabotage the crate"
description = "Break or burn the tagged crate."
optional = true

[sub_resource type="Resource" id="Item_baton"]
script = ExtResource("6_starting_item")
item = ExtResource("7_baton")

[sub_resource type="Resource" id="Item_pistol"]
script = ExtResource("6_starting_item")
item = ExtResource("8_pistol")
state = {"magazine": 10}

[sub_resource type="Resource" id="Item_ammo"]
script = ExtResource("6_starting_item")
item = ExtResource("9_ammo")
count = 10

[sub_resource type="Resource" id="Item_medkit"]
script = ExtResource("6_starting_item")
item = ExtResource("10_medkit")

[resource]
script = ExtResource("1_data")
id = &"fixture"
title = "Test mission"
briefing = "A test mission: read the manifest, then leave through the extraction zone."
objectives = Array[ExtResource("2_objective")]([SubResource("Objective_manifest"), SubResource("Objective_keycard"), SubResource("Objective_shipment")])
starting_items = Array[ExtResource("6_starting_item")]([SubResource("Item_baton"), SubResource("Item_pistol"), SubResource("Item_ammo"), SubResource("Item_medkit")])
energy_fraction = 0.5
augmentations = Array[StringName]([&"cloak", &"speed_enhancement", &"combat_strength"])
reinforcement_scenes = Array[PackedScene]([ExtResource("11_guard_pistol"), ExtResource("11_guard_pistol")])
reinforcement_delay = 30.0
