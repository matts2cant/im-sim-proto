[gd_resource type="Resource" script_class="Receptron" format=3]

[ext_resource type="Script" path="res://core/stimulus/receptron.gd" id="1_receptron"]
[ext_resource type="Script" path="res://core/stimulus/effects/effect.gd" id="2_effect"]
[ext_resource type="Script" path="res://objects/components/effects/emp_effect.gd" id="3_emp"]
[ext_resource type="Script" path="res://core/stimulus/effects/change_attribute_effect.gd" id="4_attribute"]

[sub_resource type="Resource" id="Resource_emp"]
script = ExtResource("3_emp")

[sub_resource type="Resource" id="Resource_drain"]
script = ExtResource("4_attribute")
attribute = &"energy"
per_intensity = 0.0
of_current = -0.5
max_attribute = &"energy_max"

[resource]
resource_name = "disrupted_by_emp"
script = ExtResource("1_receptron")
stimulus_type = &"emp"
effects = Array[ExtResource("2_effect")]([SubResource("Resource_emp"), SubResource("Resource_drain")])
