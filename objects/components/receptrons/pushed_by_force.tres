[gd_resource type="Resource" script_class="Receptron" format=3]

[ext_resource type="Script" path="res://core/stimulus/receptron.gd" id="1_receptron"]
[ext_resource type="Script" path="res://core/stimulus/effects/effect.gd" id="2_effect"]
[ext_resource type="Script" path="res://core/stimulus/effects/apply_impulse_effect.gd" id="3_impulse"]

[sub_resource type="Resource" id="Resource_impulse"]
script = ExtResource("3_impulse")
radial_lift = 0.3

[resource]
resource_name = "pushed_by_force"
script = ExtResource("1_receptron")
stimulus_type = &"force"
effects = Array[ExtResource("2_effect")]([SubResource("Resource_impulse")])
