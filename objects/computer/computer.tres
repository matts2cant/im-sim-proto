[resource]
script = ExtResource("1_script")
command_labels = Dictionary[StringName, String]({
&"command.open": "Open",
&"command.close": "Close",
&"command.lock": "Lock",
&"command.unlock": "Unlock",
&"command.enable": "Enable",
&"command.disable": "Disable",
&"command.stop_sweep": "Stop sweep",
&"command.resume_sweep": "Resume sweep",
&"command.pan_left": "Pan left",
&"command.pan_right": "Pan right",
&"command.target_intruders": "Target intruders",
&"command.target_guards": "Target guards",
&"command.target_everyone": "Target everyone",
&"command.trigger": "Trigger",
&"command.reset": "Reset",
&"command.disarm": "Disarm",
&"command.ring": "Ring",
&"command.test": "Test",
&"command.silence": "Silence"
})
danger_commands = Array[StringName]([&"command.disable", &"command.trigger", &"command.ring", &"command.target_everyone"])
kinds = Array[ExtResource("2_kind")]([SubResource("Kind_camera"), SubResource("Kind_turret"), SubResource("Kind_door"), SubResource("Kind_alarm"), SubResource("Kind_siren"), SubResource("Kind_radio"), SubResource("Kind_panic"), SubResource("Kind_laser")])
groups = PackedStringArray("Cameras and turrets", "Doors", "Alarm", "Laser arrays")
app_icons = Dictionary[StringName, PackedStringArray]({
&"mail": PackedStringArray("rect 3 5 18 14", "3,7 12,13 21,7"),
&"files": PackedStringArray("3,6 10,6 12,8 21,8 21,19 3,19 3,6"),
&"security": PackedStringArray("12,3 20,6 20,12 17,18 12,21 7,18 4,12 4,6 12,3")
})
refresh_interval = 0.25
error_hz = 220.0
max_use_distance = 3.0
