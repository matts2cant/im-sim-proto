[gd_resource type="Resource" script_class="AugmentationData" format=3]

[ext_resource type="Script" path="res://actors/common/abilities/augmentation_data.gd" id="1_aug"]
[ext_resource type="Script" path="res://core/attributes/modifier.gd" id="2_modifier"]

[sub_resource type="Resource" id="Modifier_move_speed_mult"]
script = ExtResource("2_modifier")
attribute = &"move_speed_mult"
op = 1
magnitude = 1.5

[sub_resource type="Resource" id="Modifier_jump_apex_height"]
script = ExtResource("2_modifier")
attribute = &"jump_apex_height"
op = 1
magnitude = 1.6

[sub_resource type="Resource" id="Modifier_mantle_max_height"]
script = ExtResource("2_modifier")
attribute = &"mantle_max_height"
op = 0
magnitude = 0.6

[sub_resource type="Resource" id="Modifier_landing_noise_mult"]
script = ExtResource("2_modifier")
attribute = &"landing_noise_mult"
op = 1
magnitude = 1.5

[resource]
script = ExtResource("1_aug")
id = &"speed_enhancement"
display_name = "Speed Enhancement"
description = "Run 1.5x faster, jump 1.6 m, mantle up to 2.5 m; landings are louder. Drains 2 energy/s."
slot = 3
passive = false
drain_per_second = 2.0
modifiers = Array[ExtResource("2_modifier")]([SubResource("Modifier_move_speed_mult"), SubResource("Modifier_jump_apex_height"), SubResource("Modifier_mantle_max_height"), SubResource("Modifier_landing_noise_mult")])
tags = Array[StringName]([])
pulse_interval = 0.5
