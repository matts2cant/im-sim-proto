[gd_resource type="Resource" script_class="SkillTable" format=3]

[ext_resource type="Script" path="res://actors/common/abilities/skill_table.gd" id="1_table"]
[ext_resource type="Script" path="res://actors/common/abilities/skill_data.gd" id="2_skill"]
[ext_resource type="Script" path="res://actors/common/abilities/skill_effect.gd" id="3_effect"]

[sub_resource type="Resource" id="Effect_pistol_spread_mult"]
script = ExtResource("3_effect")
attribute = &"pistol_spread_mult"
op = 1
tier_values = Array[float]([1.0, 0.8, 0.6, 0.4])

