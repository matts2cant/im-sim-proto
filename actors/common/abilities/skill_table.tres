[sub_resource type="Resource" id="Skill_pistols"]
script = ExtResource("2_skill")
id = &"pistols"
display_name = "Pistols"
description = "Pistol accuracy, settle, reload speed and damage."
effects = Array[ExtResource("3_effect")]([SubResource("Effect_pistol_spread_mult"), SubResource("Effect_pistol_settle_time"), SubResource("Effect_pistol_reload_mult"), SubResource("Effect_pistol_damage_mult")])

