[sub_resource type="Resource" id="Skill_lockpicking"]
script = ExtResource("2_skill")
id = &"lockpicking"
display_name = "Lockpicking"
description = "Lockpicking minigame: a wider sweet spot and lift tolerance, a shorter set dwell, a lower drop threshold, slower pin drops; assists (Trained: tension gauge, Advanced: + captions, Master: + clear lock view); Master rakes Simple and Standard locks."
effects = Array[ExtResource("3_effect")]([SubResource("Effect_lockpick_window_low"), SubResource("Effect_lockpick_window_high"), SubResource("Effect_lockpick_drop_threshold"), SubResource("Effect_lockpick_drop_delay"), SubResource("Effect_lockpick_lift_tolerance"), SubResource("Effect_lockpick_set_dwell"), SubResource("Effect_lockpick_rake"), SubResource("Effect_lockpick_assist")])

[resource]
script = ExtResource("1_table")
tier_names = Array[String](["Untrained", "Trained", "Advanced", "Master"])
skills = Array[ExtResource("2_skill")]([SubResource("Skill_pistols"), SubResource("Skill_rifles"), SubResource("Skill_sniper"), SubResource("Skill_low_tech"), SubResource("Skill_medicine"), SubResource("Skill_computer"), SubResource("Skill_lockpicking")])
