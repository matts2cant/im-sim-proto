[sub_resource type="CapsuleShape3D" id="CapsuleShape3D_body"]
radius = 0.35
height = 1.8

[node name="Player" type="CharacterBody3D"]
collision_layer = 2
collision_mask = 13
script = ExtResource("1_player")
config = ExtResource("2_config")

[node name="Collision" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.9, 0)
shape = SubResource("CapsuleShape3D_body")

[node name="Head" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.65, 0)

[node name="Camera" type="Camera3D" parent="Head"]
current = true
fov = 80.0
near = 0.05

[node name="WeaponHolder" type="Node3D" parent="Head/Camera"]
script = ExtResource("13_weapon_holder")
aim_config = ExtResource("16_aim")

[node name="FloorRay" type="RayCast3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.1, 0)
target_position = Vector3(0, -0.4, 0)
hit_back_faces = false

[node name="Noise" type="Node3D" parent="."]
script = ExtResource("3_noise")

[node name="Audio" type="AudioStreamPlayer3D" parent="Noise"]
max_polyphony = 2

[node name="Carry" type="Node" parent="."]
script = ExtResource("4_carry")

[node name="Tags" type="Node" parent="."]
script = ExtResource("5_tags")
initial_tags = Array[StringName]([&"actor.player"])

[node name="Attributes" type="Node" parent="."]
script = ExtResource("6_attributes")
base_values = Dictionary[StringName, float]({&"carry_mass_limit": 20.0, &"move_speed_mult": 1.0, &"aim_spread_add": 0.0, &"aim_sway_mult": 1.0})

[node name="StimulusReceiver" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.2, 0)
script = ExtResource("7_receiver")
receptrons = Array[ExtResource("8_receptron")]([ExtResource("9_body_damage")])

[node name="BodyParts" type="Node" parent="."]
script = ExtResource("10_body_parts")
profile = ExtResource("11_player_body")

[node name="Hitboxes" parent="." instance=ExtResource("12_hitboxes")]

[node name="Inventory" type="Node" parent="."]
script = ExtResource("19_inventory")
config = ExtResource("20_inventory_config")
catalog = ExtResource("21_catalog")

[node name="Interactor" type="Node" parent="."]
script = ExtResource("22_interactor")

[node name="Hud" parent="." instance=ExtResource("17_hud")]

[node name="InventoryScreen" parent="." instance=ExtResource("23_inventory_screen")]

[node name="ReadingOverlay" parent="." instance=ExtResource("24_reading_overlay")]
