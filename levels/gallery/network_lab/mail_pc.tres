[gd_resource type="Resource" script_class="ComputerData" format=3]

[ext_resource type="Script" path="res://objects/computer/computer_data.gd" id="1_data"]
[ext_resource type="Script" path="res://objects/computer/computer_document.gd" id="2_document"]

[sub_resource type="Resource" id="Mail_route"]
script = ExtResource("2_document")
id = &"gallery.network_lab.mail_route"
title = "Where your mail lives"
sender = "Halcyon Mail"
text = "This inbox is not on this PC: it lives on mail.halcyon.net, out on the internet, and the PC reaches it through EDGE-RTR, the edge router on the wall beside it. Cut the router's breaker and the PC loses its route: mail you have already read stays here, anything new is out of reach until the route comes back."

[sub_resource type="Resource" id="Mail_unread"]
script = ExtResource("2_document")
id = &"gallery.network_lab.mail_route_second"
title = "Second message"
sender = "Lab tech"
text = "If you can read this one, the route was up when you opened it. Flip the breaker, come back, and only what you read before is listed."

[resource]
script = ExtResource("1_data")
mail = Array[ExtResource("2_document")]([SubResource("Mail_route"), SubResource("Mail_unread")])
