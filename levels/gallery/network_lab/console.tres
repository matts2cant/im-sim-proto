[gd_resource type="Resource" script_class="ComputerData" format=3]

[ext_resource type="Script" path="res://objects/computer/computer_data.gd" id="1_data"]
[ext_resource type="Script" path="res://objects/computer/computer_document.gd" id="2_document"]

[sub_resource type="Resource" id="Mail_closet"]
script = ExtResource("2_document")
id = &"gallery.network_lab.console_mail_closet"
title = "Closet"
sender = "M. Ortiz"
text = "The spare biocells are in the closet under the camera. Its door has an electronic lock, fail-secure: open it from the Security app. Cut the closet switch's breaker and it stays shut."

[sub_resource type="Resource" id="File_rtr02"]
script = ExtResource("2_document")
id = &"gallery.network_lab.console_file_rtr02"
title = "rtr02.txt"
text = "RTR-02 (10.0.20.1) is the router from Security to the server subnet. Admin login: admin / k3epOut9."
codes = Dictionary[StringName, String]({&"network_lab_rtr02": "admin:k3epOut9"})
code_labels = Dictionary[StringName, String]({&"network_lab_rtr02": "RTR-02 login"})

[resource]
script = ExtResource("1_data")
mail = Array[ExtResource("2_document")]([SubResource("Mail_closet")])
files = Array[ExtResource("2_document")]([SubResource("File_rtr02")])
